# Variables d'environnement pour le backend BioMicro

# Mode de l'application (development, production)
APP_ENV=development

# Port du serveur
API_PORT=8000

# Chemin vers le modèle (relatif à backend/)
MODEL_PATH=app/models/model.pt

# Paramètres de normalisation (calculés sur le dataset d'entraînement)
# À récupérer du notebook de Kylian (lignes 291-295)
NORMALIZE_MEAN=0.5
NORMALIZE_STD=0.5

# Seuil de confiance minimum pour afficher le résultat
# (si la confiance est en dessous, un warning est affiché)
CONFIDENCE_THRESHOLD=0.7

# CORS - Origines autorisées (séparées par des virgules)
# En production, mettre les domaines spécifiques
CORS_ORIGINS=*

# Logs
LOG_LEVEL=INFO
